---
layout: null
---
[
  {% assign translate_posts = site.categories.translate %}
  {% for post in translate_posts %}
    {
      "title": {{ post.title | jsonify }},
      "author": {{ post.author | jsonify }},
      "url": {{ post.url | prepend: site.baseurl | jsonify }},
      "date": {{ post.date | date: "%Y. %m. %d." | jsonify }},
      "is_redirect": {% if post.re or post.layout == 'redirect' %}true{% else %}false{% endif %},
      "target": {{ post.target | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]